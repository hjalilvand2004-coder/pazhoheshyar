[Unit]
Description=پژوهشیار۳۶۰ — بازار اتصال پژوهشی اکوسیستم دانشجو۳۶۰
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__/backend
Environment=PYTHONUTF8=1
Environment=PORT=__PORT__
Environment=HOST=0.0.0.0
# مقادیر جریان SSO مطابق clients.json/پنل پرتال دانشجویار۳۶۰ —
# اگر ست باشند بر مقدار پنل مدیریت همین سامانه اولویت دارند.
Environment=SSO_CLIENT_ID=pajouhyar360
Environment=SSO_REDIRECT_URI=http://188.212.96.235:__PORT__/api/v1/auth/sso/callback
Environment=SSO_POST_LOGOUT_REDIRECT_URI=http://188.212.96.235:__PORT__/?loggedOut=1
# SECRET_KEY به‌صورت خودکار در data/.secret ساخته و پایدار نگه داشته می‌شود؛
# برای مقدار ثابت دستی، خط زیر را از حالت کامنت خارج کنید:
# Environment=SECRET_KEY=یک-مقدار-تصادفی-ثابت
ExecStart=__APP_DIR__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port __PORT__
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
